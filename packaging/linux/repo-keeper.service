# repo-keeper user service. Enable per user: systemctl --user enable --now repo-keeper
#
# The sandbox lets the daemon write only its own state/runtime directories and the clone folders below.
# Clone root elsewhere? Add a drop-in:  systemctl --user edit repo-keeper
#   [Service]
#   ReadWritePaths=/path/to/your/clones
[Unit]
Description=repo-keeper: keep local clones in sync
After=network-online.target

[Service]
ExecStart=/usr/bin/repo-keeper daemon
Restart=on-failure
RestartSec=30
StateDirectory=repo-keeper
RuntimeDirectory=repo-keeper
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/code -%h/src -%h/projects -%h/git
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
UMask=0077
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=default.target
